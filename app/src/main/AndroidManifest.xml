<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    
    <application android:allowBackup="true" 
        android:icon="@drawable/br"
        android:label="@string/app_name"
        android:roundIcon="@drawable/br"
        android:supportsRtl="true" android:theme="@style/Theme.CampusBondhu"
        android:usesCleartextTraffic="true" tools:targetApi="35">
        
        <activity android:name=".ui.SplashActivity" android:exported="true" android:theme="@style/Theme.CampusBondhu.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity android:name=".ui.auth.LoginActivity" android:exported="false" />
        <activity android:name=".ui.auth.RegisterActivity" android:exported="false" />
        <activity android:name=".ui.auth.ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.StudentDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.TeacherDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.GuardianDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.LinkStudentActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.GuardianViewStudentActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.SOSAlertsViewActivity" android:exported="false" />
        <activity android:name=".ui.profile.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.profile.EditProfileActivity" android:exported="false" />
        <activity android:name=".ui.attendance.StartAttendanceActivity" android:exported="false" />
        <activity android:name=".ui.attendance.ScanAttendanceActivity" android:exported="false" />
        <activity android:name=".ui.attendance.FaceRegisterActivity" android:exported="false" />
        <activity android:name=".ui.attendance.AttendanceHistoryActivity" android:exported="false" />
        <activity android:name=".ui.attendance.TeacherAttendanceListActivity" android:exported="false" />
        <activity android:name=".ui.notice.NoticeListActivity" android:exported="false" />
        <activity android:name=".ui.notice.CreateNoticeActivity" android:exported="false" />
        <activity android:name=".ui.library.LibraryHomeActivity" android:exported="false" />
        <activity android:name=".ui.library.AddBookActivity" android:exported="false" />
        <activity android:name=".ui.library.IssueBookActivity" android:exported="false" />
        <activity android:name=".ui.library.MyLoansActivity" android:exported="false" />
        <activity android:name=".ui.wallet.WalletActivity" android:exported="false" />
        <activity android:name=".ui.canteen.CanteenMenuActivity" android:exported="false" />
        <activity android:name=".ui.canteen.AddFoodActivity" android:exported="false" />
        <activity android:name=".ui.canteen.OrderFoodActivity" android:exported="false" />
        <activity android:name=".ui.canteen.MyOrdersActivity" android:exported="false" />
        <activity android:name=".ui.canteen.ManageOrdersActivity" android:exported="false" />
        <activity android:name=".ui.bus.BusTrackingActivity" android:exported="false" />
        <activity android:name=".ui.bus.ManageBusActivity" android:exported="false" />
        <activity android:name=".ui.studyhub.StudyHubActivity" android:exported="false" />
        <activity android:name=".ui.studyhub.UploadResourceActivity" android:exported="false" />
        <activity android:name=".ui.marketplace.MarketplaceActivity" android:exported="false" />
        <activity android:name=".ui.marketplace.AddListingActivity" android:exported="false" />
        <activity android:name=".ui.academic.CgpaCalculatorActivity" android:exported="false" />
        <activity android:name=".ui.academic.ManageCoursesActivity" android:exported="false" />
        <activity android:name=".ui.academic.ViewRoutineActivity" android:exported="false" />
        <activity android:name=".ui.academic.ManageRoutineActivity" android:exported="false" />
        <activity android:name=".ui.sos.SOSActivity" android:exported="false" />
        <activity android:name=".ui.sos.SOSAlertsListActivity" android:exported="false" />
        <activity android:name=".ui.assistant.AIChatActivity" android:exported="false" />
        <activity android:name=".ui.admin.ManageUsersActivity" android:exported="false" />
        <activity android:name=".ui.admin.ManageMarketplaceActivity" android:exported="false" />

        <service android:name=".data.remote.CampusMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        
        <!-- ✅ ফোরগ্রাউন্ড সার্ভিস রেজিস্টার করা হলো -->
        <service android:name=".data.remote.SOSForegroundService" 
            android:foregroundServiceType="location" android:exported="false" />

        <!-- ✅ ব্রডকাস্ট রিসিভার রেজিস্টার করা হলো -->
        <receiver android:name=".data.remote.SystemStateReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.AIRPLANE_MODE_CHANGED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
            </intent-filter>
        </receiver>

        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="campusbondhu_default" />
    </application>
</manifest>
