<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/navy_800">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvLoanTitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Book Title"
            android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/tvLoanIssueDate" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Issued: Date" android:textColor="@color/grey_500" android:textSize="12sp" />
            <TextView android:id="@+id/tvLoanDueDate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Due: Date"
                android:textColor="@color/grey_500" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvLoanStatus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="ISSUED" android:textStyle="bold" android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnReturnBook"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_gravity="end" android:layout_marginTop="8dp"
            android:text="Return Book" android:textColor="@color/teal_success"
            app:strokeColor="@color/teal_success" android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
