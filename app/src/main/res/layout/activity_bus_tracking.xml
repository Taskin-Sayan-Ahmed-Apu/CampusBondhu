<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy_900">

    <!-- Header -->
    <LinearLayout android:id="@+id/header"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/navy_900"
        android:elevation="4dp"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageButton android:id="@+id/btnBack" android:layout_width="44dp"
            android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert" app:tint="@color/white" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:text="Live Bus Tracking"
            android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/btnManageBus" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Manage"
            android:textColor="@color/blue_accent" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>

    <!-- Map -->
    <org.osmdroid.views.MapView android:id="@+id/mapView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_below="@id/header" android:layout_above="@id/rvBuses" />

    <!-- My Location Button (Floating) -->
    <ImageButton android:id="@+id/btnMyLocation"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_above="@id/rvBuses" android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp" android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_white"
        android:src="@android:drawable/ic_menu_mylocation"
        app:tint="@color/blue_accent" />

    <!-- Bottom Bus List -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvBuses"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:padding="8dp"
        android:background="@color/navy_800" />
</RelativeLayout>
