<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/navy_800">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvFoodName" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Food Name"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvFoodDesc" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Description" android:textColor="@color/grey_500" android:textSize="12sp" />
        <TextView android:id="@+id/tvFoodPrice" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="৳ 0.00" android:textColor="@color/teal_success"
            android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
